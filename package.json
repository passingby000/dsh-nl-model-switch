{
  "name": "dsh-nl-model-switch",
  "version": "0.1.0",
  "description": "Switch the current DSH session's model with a natural-language sentence (independent of any IM bridge).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/passingby000/dsh-nl-model-switch.git"
  },
  "keywords": ["dsh", "dsh-plugin", "model-switch", "deepseek-harness", "natural-language"],
  "author": "passingby000",
  "license": "MIT"
}
